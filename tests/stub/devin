#!/usr/bin/env bash
# Fake `devin` for tests/smoke.sh. Records args and prompt in $STUB_OUT, writes the --export JSON, exits $STUB_EXIT.
# STUB_APPEND_BOARD="<text>": append that line to $STUB_BOARD, like a lane posting DONE.
case "${1:-}" in
  version) echo "devin stub 0.0.0"; exit 0;;
  auth) if [ "${STUB_AUTH:-in}" = in ]; then echo "Logged in (via Stub)."; exit 0; else echo "Not logged in."; exit 1; fi;;
  models) [ "${STUB_NO_MODEL:-0}" = 1 ] || printf '  %s\n' "${STUB_AVAILABLE_MODEL:-swe-2-flash-high}"; exit 0;;
  list) echo "[]"; exit 0;;
  rm) exit 0;;
esac
sid=""; prompt=""; export_f=""; model=""; perm=""
while [ $# -gt 0 ]; do
  case "$1" in
    -p) prompt=$2; shift 2;;
    -r) sid=$2; shift 2;;
    --export) export_f=$2; shift 2;;
    --model) model=$2; shift 2;;
    --permission-mode) perm=$2; shift 2;;
    *) shift;;
  esac
done
n=$(cat "$STUB_OUT/count" 2>/dev/null || echo 0); n=$((n + 1)); echo "$n" > "$STUB_OUT/count"
printf 'call=%s resume=%s model=%s perm=%s\n' "$n" "${sid:-no}" "$model" "$perm" >> "$STUB_OUT/args.log"
printf '=== call %s ===\n%s\n' "$n" "$prompt" >> "$STUB_OUT/prompts.log"
[ -n "${STUB_OUTPUT:-}" ] && echo "$STUB_OUTPUT"
[ -n "${STUB_SLEEP:-}" ] && sleep "$STUB_SLEEP"
# STUB_WRITE="<path>::<text>" writes that file (from call number STUB_WRITE_FROM, default 1), like a lane producing output.
# Several files: separate the entries with @@@ (optional per-entry call filter: 3=path::text, 3>path::text).
if [ -n "${STUB_WRITE:-}" ] && [ "$n" -ge "${STUB_WRITE_FROM:-1}" ]; then
  rest=$STUB_WRITE
  while [ -n "$rest" ]; do
    ent=${rest%%@@@*}; if [ "$ent" = "$rest" ]; then rest=""; else rest=${rest#*@@@}; fi
    # an entry may start with "N=" (only on call N) or "N>" (from call N on)
    case "$ent" in [0-9]*=*) [ "$n" = "${ent%%=*}" ] || continue; ent=${ent#*=};; [0-9]*">"*) [ "$n" -ge "${ent%%>*}" ] || continue; ent=${ent#*>};; esac
    mkdir -p "$(dirname "${ent%%::*}")"; printf '%s\n' "${ent#*::}" > "${ent%%::*}"
  done
fi
[ -n "${STUB_APPEND_BOARD:-}" ] && echo "$STUB_APPEND_BOARD" >> "$STUB_BOARD"
[ -n "$export_f" ] && printf '{"session_id":"%s"}\n' "${sid:-stub-session-$n}" > "$export_f"
exit "${STUB_EXIT:-0}"
